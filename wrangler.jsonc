{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "discord-digest",
  "main": "src/index.tsx",
  "compatibility_date": "2026-08-05",

  "ai": { "binding": "AI" },

  // 静的ファイル。アセットは Worker より先に処理されるため、
  // ここに置いたものは認証を通らず誰でも取得できる。
  // OGP 画像はクローラーに読ませたいので、その挙動でちょうどよい。
  "assets": { "directory": "./public" },

  // 秘密情報ではないので secret ではなく設定に置く。
  // このサーバー（じょぎ / 情報技術研究部）のメンバーだけがログインできる。
  "vars": { "ALLOWED_GUILD_ID": "1215894283899633664" },

  "durable_objects": {
    "bindings": [{ "name": "DIGEST_JOB", "class_name": "DigestJob" }]
  },

  // Workers Free プランは SQLite バックエンドのみサポート。
  // new_classes（KVバックエンド）は新規アカウントでは拒否されるので使わないこと。
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DigestJob"] }],

  "observability": { "enabled": true, "logs": { "head_sampling_rate": 1 } }

  // Paid プランへ移行したら有効化する（Free では設定できない）:
  // "limits": { "cpu_ms": 300000 }
}
